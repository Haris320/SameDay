# SameDay environment variables
# Rename this file to .env at the backend root. Never commit it (add .env to .gitignore).
# Share with your teammate privately (direct message), not in a public channel or the repo.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Terac (get access from organizers) ---
TERAC_API_KEY=
TERAC_WEBHOOK_SECRET=
TERAC_PROJECT_ID=

# --- Stripe (sandbox, sk_test_...) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LINK_FUND_URL=
STRIPE_LINK_FEE_URL=

# --- Whop (SANDBOX) ---
WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_BIZ_ID=
WHOP_WEBHOOK_SECRET=

# --- Supabase (backend only: secret key has full database access) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Supabase (frontend / Lovable: safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Backend public URL (deploy or tunnel, must be https) ---
PUBLIC_BASE_URL=

# --- Optional ---
EXA_API_KEY=

# --- Mock flags (set to 1 for offline rehearsal) ---
MOCK_TERAC=0
MOCK_WHOP=0
MOCK_EXA=1